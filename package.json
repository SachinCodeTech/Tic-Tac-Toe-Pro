{
  "name": "tic-tac-toe-pro",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "generate:icons": "node scripts/generate-icons.mjs",
    "build": "node scripts/generate-icons.mjs && node --check server.js",
    "lint": "node --check server.js && node --check scripts/generate-icons.mjs",
    "ios:sync": "npm run build && npx cap sync ios",
    "android:sync": "npm run build && npx cap sync android",
    "mobile:sync": "npm run build && npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "express": "^4.21.2",
    "sharp": "^0.35.5"
  }
}
