{
  "appId": "com.codetech.tictactoepro",
  "appName": "Tic Tac Toe Pro",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#eff6ff",
    "preferredContentMode": "mobile"
  },
  "android": {
    "backgroundColor": "#eff6ff"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 350,
      "backgroundColor": "#eff6ff",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#eff6ff"
    }
  }
}
